# ===== DATABASE =====
# Database connection string for development (SQLite) or production (PostgreSQL)
# SQLite: sqlite:///./clarityai.db
# PostgreSQL: postgresql://user:password@localhost:5432/clarityai_db
DATABASE_URL=sqlite:///./clarityai.db

# PostgreSQL specific (for production)
DB_USER=clarityai
DB_PASSWORD=change_me_in_production
DB_NAME=clarityai_db
DB_HOST=db
DB_PORT=5432

# ===== MODEL & ML =====
# Path to the trained model weights
MODEL_PATH=./models/model_v1.pt

# Path to the classical ML model (e.g., gradient boosting model)
CLASSICAL_MODEL_PATH=./models/classical_model.joblib

# ===== API & BACKEND =====
# Backend API host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS origins (comma-separated) - frontend origin
CORS_ORIGINS=http://localhost:3000,http://localhost

# API version prefix
API_VERSION=v1

# ===== FRONTEND =====
# Frontend URL for API calls (if different from backend)
FRONTEND_URL=http://localhost:3000

# ===== LOGGING =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=./logs/app.log

# ===== FILE UPLOAD =====
# Maximum file size in bytes (50MB default)
MAX_FILE_SIZE=52428800

# Allowed image formats (comma-separated)
ALLOWED_FORMATS=image/jpeg,image/png,image/webp

# Temporary upload directory
UPLOAD_DIR=./temp/uploads

# ===== DEPLOYMENT =====
# Environment: development, staging, production
ENVIRONMENT=development

# App name and version
APP_NAME=ClarityAI
APP_VERSION=1.0.0

# ===== SECURITY =====
# Secret key for session management (generate a strong random string in production)
SECRET_KEY=your-secret-key-here-change-in-production

# ===== OPTIONAL: MONITORING & OBSERVABILITY =====
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Prometheus metrics endpoint (optional)
ENABLE_PROMETHEUS=false
